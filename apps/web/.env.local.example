# Copy to apps/web/.env.local for local development.

# Mapbox GL access token (public token is OK for local dev; do not commit real secrets to git).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me

# Optional: custom Mapbox Studio style (mapbox://... or https://api.mapbox.com/styles/v1/.../...)
# NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11

# Python API base URL (FastAPI defaults to http://127.0.0.1:8000).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
