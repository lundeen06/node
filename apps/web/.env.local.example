# Copy this file to `.env.local` in this folder and fill in values.
# Next.js reads `.env.local` automatically; that file is gitignored.

# Proxy target for same-origin `/node-api/*` in dev (next.config.js). Use the port uvicorn listens on.
NODE_API_UPSTREAM=http://127.0.0.1:8000

# Optional: talk to the API directly from the browser (requires CORS on the API for this origin).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000


# Equirectangular Earth albedo — file must live under apps/web/public/ (served as /filename.jpg).
# Example: put earth.jpg in public/ then:
# NEXT_PUBLIC_EARTH_ALBEDO_URL=/earth.jpg
# NEXT_PUBLIC_EARTH_ALBEDO_URL=
