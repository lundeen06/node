# -----------------------------------------------------------------------------
# Space-Track — copy this file to `.env` in this folder and fill in real values.
# Path: apps/api/.env   (same directory as pyproject.toml)
# `.env` is gitignored; do not commit passwords.
#
# Sign up: https://www.space-track.org  → use your website login + password below.
# -----------------------------------------------------------------------------

NODE_SPACETRACK_IDENTITY=
NODE_SPACETRACK_PASSWORD=
# Space-Track requires an identifiable User-Agent (app name + contact email or URL).
NODE_SPACETRACK_USER_AGENT=my-org-node/0.1 (+you@example.com)

# --- OpenAI (required for POST /agent/turn in the ops UI) ---
NODE_OPENAI_API_KEY=

# --- Optional ---
# NODE_APP_NAME=node API
# NODE_DEBUG=false
# NODE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# NODE_DATABASE_URL=sqlite:///C:/path/to/custom.sqlite
